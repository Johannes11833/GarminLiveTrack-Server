{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter (chrome)",
            "type": "dart",
            "request": "launch",
            "program": "garmin_livetrack_viewer/lib/main.dart",
            "deviceId": "chrome",
            "args": [
                "--dart-define=API_BASE_URL=http://127.0.0.1:8000"
            ]
        },
        {
            "name": "Flutter (web server)",
            "type": "dart",
            "request": "launch",
            "program": "garmin_livetrack_viewer/lib/main.dart",
            "deviceId": "web-server",
            "args": [
                "--web-hostname",
                "0.0.0.0",
                "--web-port",
                "8080",
                "--dart-define=API_BASE_URL=http://localhost:8000",
            ]
        },
        {
            "name": "Python Debugger: livetrack_api.py",
            "type": "debugpy",
            "request": "launch",
            "program": "garmin_livetrack/livetrack_api.py",
            "console": "integratedTerminal",
            "env": {
                "LIVETRACK_ENABLE_DUMMY_MODE": "yes"
            }
        }
    ]
}