FROM python:3.13-alpine AS base

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH"


FROM base AS builder

ENV POETRY_NO_INTERACTION=1 \
    POETRY_VIRTUALENVS_IN_PROJECT=1 \
    POETRY_VIRTUALENVS_CREATE=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache

WORKDIR /app

# Install Poetry
RUN pip install poetry==1.6.1

# Install dependencies first so this layer stays cached across source
# changes, then install the project itself so its console scripts
# (garmin-livetrack-email-listener, garmin-livetrack-api) get written into
# the venv.
COPY pyproject.toml poetry.lock ./
RUN poetry install --no-root --with api && rm -rf $POETRY_CACHE_DIR

COPY garmin_livetrack /app/garmin_livetrack
RUN poetry install --with api && rm -rf $POETRY_CACHE_DIR


FROM base AS runtime

# The tracker talks to Garmin over plain HTTP (no browser), so the API runs
# on Alpine like the email listener: only the Python venv is copied over.
COPY --from=builder ${VIRTUAL_ENV} ${VIRTUAL_ENV}
COPY garmin_livetrack /app/garmin_livetrack

WORKDIR /app

EXPOSE 8000

ENTRYPOINT ["garmin-livetrack-api"]
